# CargoOne Customer — .env.example
#
# Copy this file to `.env` on your machine and fill in real values.
# NEVER commit the actual .env — it is gitignored.
#
# ────────────────────────────────────────────────────────────────
# Backend origin — where the native app makes /api/* calls
# ────────────────────────────────────────────────────────────────
# In production the app defaults to https://cargoone.co.uk when this
# variable is missing, so setting it is only necessary for local dev
# against a preview / staging backend. Never use a plain HTTP origin
# on iOS — App Transport Security will block the request and fetch
# will throw "Network request failed".
EXPO_PUBLIC_BACKEND_URL=https://cargoone.co.uk

# ────────────────────────────────────────────────────────────────
# Mapbox — PUBLIC runtime token (pk.*), NOT the secret sk.* one
# ────────────────────────────────────────────────────────────────
# Used at runtime by @rnmapbox/maps to fetch map tiles. The SECRET
# sk.* downloads token belongs in your shell env only — see
# mobile/SECRETS.md.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ1I...

# ────────────────────────────────────────────────────────────────
# Stripe — publishable key (pk_*), NOT the secret one
# ────────────────────────────────────────────────────────────────
# Only the publishable key belongs in the mobile app. The Stripe
# secret key is used server-side only.
EXPO_PUBLIC_STRIPE_PK=pk_live_...
