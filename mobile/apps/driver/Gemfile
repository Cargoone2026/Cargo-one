source 'https://rubygems.org'

# Locked to the Ruby version supplied by the SDK 51 template so
# `bundle exec pod install` behaves identically on every developer's
# Mac irrespective of their system Ruby.
ruby ">= 2.6.10"

# CocoaPods 1.14.x still calls `JSON.parse(..., quirks_mode: true)`
# internally. Ruby's `json` gem removed `quirks_mode` in 2.8.0
# (Aug 2024). macOS Sonoma/Sequoia ship Ruby 3.4 which resolves
# `json` to 2.8+ by default, breaking `pod install` with:
#   Invalid `Podfile` file: unknown keyword: quirks_mode
# Pinning `json` to the 2.7 series keeps `quirks_mode` available.
gem 'json', '~> 2.7', '< 2.8'

# Cocoapods 1.15 introduced a regression that breaks `use_frameworks!`
# builds. 1.16+ requires Ruby 3.4 + `json 2.8` which fights our pin.
# Expo SDK 51's template canonical range is >= 1.13, < 1.15.
gem 'cocoapods', '>= 1.13', '< 1.15'

# activesupport 7.1+ requires Ruby 3.1; keep on the 6.1/7.0 line to
# stay compatible with the widest Ruby range that the json pin allows.
gem 'activesupport', '>= 6.1.7.5', '< 7.1.0'

# xcodeproj 1.25+ requires Ruby 3.4 and pulls json 2.8. Pin to the
# highest release still compatible with Ruby 3.3 / 3.2.
gem 'xcodeproj', '< 1.26.0'
