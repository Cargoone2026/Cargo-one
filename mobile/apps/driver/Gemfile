source 'https://rubygems.org'

# Locked to the Ruby version supplied by the SDK 51 template so
# `bundle exec pod install` behaves identically on every developer's
# Mac irrespective of their system Ruby.
ruby ">= 2.6.10"

# CocoaPods 1.14.x still calls `JSON.parse(..., quirks_mode: true)`
# internally. Ruby's `json` gem removed `quirks_mode` in 2.8.0
# (Aug 2024). macOS Sonoma/Sequoia ship Ruby 3.4 which resolves
# `json` to 2.8+ by default, breaking `pod install` with:
#   Invalid `Podfile` file: unknown keyword: quirks_mode
# Pinning `json` to the 2.7 series keeps `quirks_mode` available.
gem 'json', '~> 2.7', '< 2.8'

# Cocoapods 1.15 introduced a regression that breaks `use_frameworks!`
# builds. 1.16+ requires Ruby 3.4 + `json 2.8` which fights our pin.
# Expo SDK 51's template canonical range is >= 1.13, < 1.15.
gem 'cocoapods', '>= 1.13', '< 1.15'

# activesupport 7.1+ requires Ruby 3.1; keep on the 6.1/7.0 line to
# stay compatible with the widest Ruby range that the json pin allows.
gem 'activesupport', '>= 6.1.7.5', '< 7.1.0'

# xcodeproj must be >= 1.28.1 so that Bundler pulls the `nkf` and
# `base64` gems as transitive runtime dependencies. On Ruby 3.4+
# (Sonoma default) and Ruby 4.x (Homebrew current) these two libraries
# are no longer bundled with the interpreter, so `require 'kconv'`
# — which CFPropertyList's rbCFPropertyList.rb performs at load time
# — raises `LoadError: cannot load such file -- kconv` unless `nkf`
# has been installed as a real gem (the `nkf` gem ships both
# `nkf.rb` and `kconv.rb`). xcodeproj 1.28.1 was the first release
# to declare `s.add_runtime_dependency 'nkf', '>= 0'` and
# `s.add_runtime_dependency 'base64', '>= 0'` for exactly this
# reason (see xcodeproj-1.28.1.gemspec).
#
# Compatibility of 1.28.1 with our pinned stack has been verified:
#   • required_ruby_version = ">= 2.6.0"  (works on Ruby 2.6 → 4.x)
#   • declares NO `json` dependency        (the `json '~> 2.7'` pin
#                                           above stays effective for
#                                           CocoaPods' quirks_mode)
#   • CocoaPods 1.14.3 accepts xcodeproj   (>= 1.23.0, < 2.0)
#   • pulls CFPropertyList 3.0.x           (>= 2.3.3, < 4.0)
gem 'xcodeproj', '>= 1.28.1'
