{
  "name": "@cargoone/driver",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "bundle install --gemfile=./Gemfile && expo prebuild --clean --no-install && node ../../scripts/apply-node-modules-fixes.js && (cd ios && BUNDLE_GEMFILE=../Gemfile bundle exec pod install)",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cargoone/core": "*",
    "@expo/vector-icons": "^14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@rnmapbox/maps": "10.1.31",
    "expo": "~51.0.28",
    "expo-dev-client": "~4.0.29",
    "expo-image-picker": "~15.0.7",
    "expo-local-authentication": "~14.0.1",
    "expo-location": "~17.0.1",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-signature-canvas": "^4.7.2",
    "react-native-webview": "~13.8.6"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.79",
    "typescript": "5.3.3"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "expo-splash-screen",
        "expo-notifications",
        "expo-secure-store",
        "@stripe/stripe-react-native",
        "react-native-passkey",
        "react-native-reanimated",
        "react-native-svg"
      ]
    }
  }
}
