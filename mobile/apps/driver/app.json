{
  "expo": {
    "name": "CargoOne Driver",
    "slug": "cargoone-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cargoonedriver",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0A0A0A",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "co.uk.cargoone.driver",
      "supportsTablet": true,
      "associatedDomains": ["webcredentials:cargoone.co.uk", "applinks:cargoone.co.uk"],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Share your location so you can go online and receive nearby ASAP jobs.",
        "NSFaceIDUsageDescription": "Unlock the Cargo One Driver app with Face ID"
      }
    },
    "android": {
      "package": "co.uk.cargoone.driver",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111111"
      },
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "plugins": [
      "../../plugins/withCargoOneiOSFixes",
      [
        "@rnmapbox/maps",
        {}
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Share your location so you can go online and receive nearby ASAP jobs."
        }
      ]
    ],
    "extra": {
      "eas": { "projectId": "REPLACE_ME_ON_EAS_INIT" }
    }
  }
}
